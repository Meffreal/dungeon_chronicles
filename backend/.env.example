# ── Dungeon Chronicles — příklad konfigurace prostředí ──────────────────────
# Zkopíruj tento soubor jako .env a upravte hodnoty pro své prostředí.
# .env je automaticky načten přes pydantic-settings.

# ── JWT Security ─────────────────────────────────────────────────────────────
# POVINNÉ pro produkci: změň na náhodný bezpečný řetězec (min. 32 znaků)
# Generování: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dungeon-chronicles-super-secret-change-in-production

# ── Databáze ─────────────────────────────────────────────────────────────────
# Výchozí: SQLite (dev/local)
# DATABASE_URL=sqlite+aiosqlite:///./dungeon.db

# PostgreSQL (doporučeno pro produkci):
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/dungeon_chronicles
#
# Při přepnutí na PostgreSQL:
# 1. Vytvoř DB: createdb dungeon_chronicles
# 2. Nastav DATABASE_URL výše
# 3. Spusť migrace: alembic upgrade head
#    (spouští se automaticky i při startu serveru)

# ── Redis ─────────────────────────────────────────────────────────────────────
# Volitelné. Pokud není nastaven, používá se in-memory fallback (single-instance).
# Redis přidává: cross-instance rate limiting, leaderboard cache, cooldown cache
#
# Lokální Redis:
# REDIS_URL=redis://localhost:6379
#
# Redis s heslem:
# REDIS_URL=redis://:heslo@localhost:6379/0
#
# Redis Sentinel / Cluster:
# REDIS_URL=redis://sentinel1:26379,sentinel2:26379/mymaster
