# Dungeon Chronicles — konfigurace prostredí
# Zkopíruj jako .env a vyplň hodnoty

# JWT tajný klíč (vygeneruj nahodný string: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=zmen-tuto-hodnotu-na-nahodny-string

# Admin panel klíč
ADMIN_KEY=dungeon-admin-2024

# Databáze (pro produkci PostgreSQL)
# SQLite (vývoj — výchozí):
DATABASE_URL=sqlite+aiosqlite:///./dungeon.db
# PostgreSQL (produkce — Railway/Render):
# DATABASE_URL=postgresql+asyncpg://user:password@host/dbname

# CORS — povolené origins (pro produkci nastav konkrétní doménu)
# ALLOWED_ORIGINS=https://tvoje-domena.com
